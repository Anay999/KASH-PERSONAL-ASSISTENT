# Project JARVIS Environment Configuration

# Server Ports and Host
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Ollama Local LLM Settings
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_MODEL=qwen2.5:3b
JARVIS_REASONING_MODEL=deepseek-r1:1.5b

# Voice Recognition (Speech-to-Text)
WHISPER_MODEL=tiny
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# Text-to-Speech (TTS)
# Primary British Voice (requires internet connection)
TTS_VOICE=en-GB-RyanNeural
# pyttsx3 offline fallback will be automatically engaged if offline or Edge TTS fails
